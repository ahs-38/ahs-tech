<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="android:Theme.Material3.DayNight">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowSplashScreenContent">@style/Theme.SplashScreen</item>
    </style>

    <style name="Theme.SplashScreen" parent="Theme.App">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenContent">@layout/splash_screen</item>
    </style>

    <style name="Theme.App.Light" parent="android:Theme.Material3.Light">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.App.Dark" parent="android:Theme.Material3.Dark">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>